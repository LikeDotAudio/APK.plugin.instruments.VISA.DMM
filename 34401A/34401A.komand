    "Get_Func": {
      "scpi": "FUNCtion?",
      "scpiFast": "FUNC?",
      "description": "Which measurement function is selected",
      "returns": {
        "count": 1,
        "type": "CRD"
      },
      "group": "One command per measurement function",
      "subsystem": "Panel"
    },
    "meter_reading": {
      "scpi": "FUNCtion?;:READ?",
      "scpiFast": "FUNC?;:READ?",
      "description": "What the meter is measuring, and the measurement, together.",
      "group": "Fetch data after INITiate",
      "subsystem": "MEASure",
      "returns": {
        "count": 2,
        "separator": ";",
        "fields": [
          {
            "name": "function",
            "type": "CRD"
          },
          {
            "name": "value",
            "type": "NR3"
          }
        ]
      },
      "notes": "One round trip, because the two facts have to agree: asking the function and the value separately lets the function change between them, and a number labelled with the previous function is worse than an unlabelled one. The chained query restarts at the root — see Measure_All on the 6060B for what happens when it does not. Verified on the 34401A at 44.44.44.111 gpib7,4: answers \"VOLT\";+1.00199800E-03 with a clean error queue. Note the reply is the SHORT form — DC volts answers \"VOLT\", not \"VOLT:DC\" — while FUNCtion accepts either when setting."
    },
    "Get_Measure_Continuity": {
      "scpi": "MEASure:CONTinuity?",
      "scpiFast": "MEAS:CONT?",
      "description": "The MEASure? and CONFigure Commands",
      "returns": {
        "count": 1,
        "type": "NR3",
        "unit": "Ω"
      },
      "subsystem": "MEAS",
      "unverified": true,
      "notes": "Returns NR3: a resistance reading, 9.90000000E+37 when open (bench, Certify 2026-11; 34401-90004 Ch. 4: an overload or infinite value reads 9.90000000E+37) — not a 0/1 state."
    },
